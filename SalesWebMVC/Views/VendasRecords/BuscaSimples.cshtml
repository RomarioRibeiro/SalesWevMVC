@model IEnumerable<SalesWebMVC.Models.VendasRecord>
@{
    ViewData["Title"] = "Busca simples";
}

<h2>@ViewData["Title"]</h2>

<hr />
<div style="margin-bottom: 10px">
    <a asp-action="Index" class="btn btn-secondary">Volta</a>
</div>
<div class="card">
    <div class="card-body">
        <nav class="navbar navbar-inverse">
            <div class="container-fluid">
                <form class="navbar-form navbar-left" role="search">
                    <div class="row">
                        <div class="col">
                            <label for="minData">Data Minima</label>
                            <input type="date" class="form-control" name="minData" value=@ViewData["minData"] />
                        </div>
                        <div class="col">
                            <label for="maxData">Data Maxima</label>
                            <input type="date" class="form-control" name="maxData" value=@ViewData["maxData"] />
                        </div>
                    </div>
                    <div style="margin-top: 10px">
                    <button type="submit" class="btn btn-primary">Filter</button>

                    </div>
                </form>
            </div>
        </nav>
        <div class="panel panel-primary painel-departamento">
            <div class="panel-heading painel-header">
                <h3 class="panel-title">Total Vendas: R$  @Model.Sum(obj => obj.Venda).ToString("F2")</h3>
            </div>
            <div class="panel-body painel-body">
                <table class="table table-striped table-hover tabela-vendas">
                    <thead>
                        <tr class="success">
                            <th>
                                @Html.DisplayNameFor(model => model.Id)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.Data)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.Vendedores)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.Vendedores.Departamento)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.Venda)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.Status)
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Id)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Data)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Vendedores.Nome)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Vendedores.Departamento.Descricao)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Venda)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Status)
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
