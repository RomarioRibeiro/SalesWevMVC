﻿@{
ViewData["Title"] = "Vendas Records";
}

<h2>@ViewData["Title"]</h2>
<div class="card">
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <form class="form-horizontal" asp-action="BuscaSimples">
                    <fieldset>
                        <legend>Busca Simples</legend>
                        <div class="form-group">
                            <label for="minDate" class="col-lg-2 control-label">Data minima</label>
                            <div class="col-lg-10">
                                <input type="date" name="minDate" class="form-control" />
                            </div>
                        </div>
                        <div class="form-group">
                            <label for="maxDate" class="col-lg-2 control-label">Data maxima</label>
                            <div class="col-lg-10">
                                <input type="date" name="maxDate" class="form-control" />
                            </div>
                        </div>
                        <div class="form-group" style="margin-top: 10px; margin-bottom: 10px">
                            <div class="col-lg-10 col-lg-offset-2">
                                <button type="submit" class="btn btn-primary">Buscar</button>
                            </div>
                        </div>
                    </fieldset>
                </form>
            </div>
        </div>
    </div>
</div>
<hr />
<div class="card">
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <form class="form-horizontal" asp-action="GroupBusca">
                    <fieldset>
                        <legend>Grupo de busca</legend>
                        <div class="form-group">
                            <label for="minDate" class="col-lg-2 control-label">Data minima</label>
                            <div class="col-lg-10">
                                <input type="date" name="minDate" class="form-control" />
                            </div>
                        </div>
                        <div class="form-group">
                            <label for="maxDate" class="col-lg-2 control-label">Data maxima</label>
                            <div class="col-lg-10">
                                <input type="date" name="maxDate" class="form-control" />
                            </div>
                        </div>
                        <div class="form-group" style="margin-top: 10px;">
                            <div class="col-lg-10 col-lg-offset-2">
                                <button type="submit" class="btn btn-primary">Buscar</button>
                            </div>
                        </div>
                    </fieldset>
                </form>
            </div>
        </div>
    </div>
</div>
