@model IEnumerable<SalesWebMVC.Models.Vendedores>
@*

    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewData["Title"] = "Vendedores";
}

<h2>Vendedores</h2>

<p>Vendedores Index page</p>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Nome)
            </th> 
            <th>
                @Html.DisplayNameFor(model => model.Email)
            </th> 
            <th>
                @Html.DisplayNameFor(model => model.DiaNacimento)
            </th> 
            <th>
                @Html.DisplayNameFor(model => model.SalarioBase)
            </th> 
            <th></th>

        </tr>
    </thead>
    <tbody>
        @foreach(var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Nome)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Email)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.DiaNacimento)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.SalarioBase)
                </td>
                <td>
                    <a class="btn btn-primary" asp-action="Edit" asp-route-id="@item.Id">Editar</a>
                    <a class="btn btn-primary" asp-action="Details" asp-route-id="@item.Id">Detalhes</a>
                    <a class="btn btn-primary" asp-action="Delete" asp-route-id="@item.Id">Deletar</a>
                </td>
            </tr>
        }


    </tbody>

</table>