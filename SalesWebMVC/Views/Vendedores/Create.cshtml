@model SalesWebMVC.Models.ViewModel.VendedoresFormViewModel

@{
    ViewData["Title"] = "Create";
}

<h2>@ViewData["Title"]</h2>

<h4>Vendedor</h4>
<hr />

<div class="card">
    <div class="card-body">
        <div class="row">
            <div class="col-md-4">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="form-group">
                        <label asp-for="Vendedores.Nome" class="control-label"></label>
                        <input asp-for="Vendedores.Nome" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label asp-for="Vendedores.Email" class="control-label"></label>
                        <input asp-for="Vendedores.Email" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label asp-for="Vendedores.DiaNacimento" class="control-label"></label>
                        <input asp-for="Vendedores.DiaNacimento" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label asp-for="Vendedores.SalarioBase" class="control-label"></label>
                        <input asp-for="Vendedores.SalarioBase" class="form-control" />
                    </div>
                        
                    <div class="form-group">
                        <label asp-for="Vendedores.DepartamentoId" class="control-label"></label>
                        <select asp-for="Vendedores.DepartamentoId" asp-items="@(new SelectList(Model.Departamentos, "Id", "Descricao"))" class="form-control"></select>
                    </div>

                    <div class="form-group" style="margin-top: 10px">
                        <input type="submit" value="Salvar" class="btn btn-primary" />
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
