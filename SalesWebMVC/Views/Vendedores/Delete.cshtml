@model SalesWebMVC.Models.Vendedores
@{
    ViewData["Title"] = "Excluindo Vendedor";
}

<h2>@ViewData["Title"]</h2>
<h3>Tem certeza que deseja deletar ?</h3>

<hr />
<div class="card">
    <div class="card-body">
        <div>
            <dl class="dl-horizontal">
                <dt>
                    @Html.DisplayNameFor(model => model.Nome)
                </dt>
                <dd>
                    @Html.DisplayFor(model => model.Nome)
                </dd>
                <dt>
                    @Html.DisplayNameFor(model => model.Email)
                </dt>
                <dd>
                    @Html.DisplayFor(model => model.Email)
                </dd>
                <dt>
                    @Html.DisplayNameFor(model => model.DiaNacimento)
                </dt>
                <dd>
                    @Html.DisplayFor(model => model.DiaNacimento)
                </dd>
                <dt>
                    @Html.DisplayNameFor(model => model.SalarioBase)
                </dt>
                <dd>
                    @Html.DisplayFor(model => model.SalarioBase)
                </dd>
            </dl>
        </div>
    </div>
</div>
<div class="card-footer" style="text-align: end">
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Delete" class="btn btn-danger" /> 
        <a class="btn btn-primary" asp-action="Index">Voltar</a>
    </form>
</div>


