@model SalesWebMVC.Models.Departamento

@{
    ViewData["Title"] = "Details";
}

<h1>Detalhe do Departamento</h1>
<hr />
<div class="botao-voltar">
    <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model?.Id">Editar</a> 
    <a class="btn btn-secondary" asp-action="Index">Voltar</a>
</div>
<div class="card">

    <div class="card-body">
        <div class="row">
            <div class="col-sm-2">
                @Html.DisplayNameFor(model => model.Descricao)
            </div>
            <div class="col-sm-10">
                @Html.DisplayFor(model => model.Descricao)
            </div>
        </div>
    </div>
</div>
